# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must have Unix line endings
*.sh text eol=lf
docker-build.sh text eol=lf

# Batch files should have Windows line endings
*.bat text eol=crlf

# Docker files should have Unix line endings
Dockerfile* text eol=lf

# CMake files
CMakeLists.txt text eol=lf
*.cmake text eol=lf

# C++ source files
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf

# Qt files
*.ui text eol=lf
*.qrc text eol=lf

# Config files
*.json text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binary files
*.png binary
*.ico binary
*.wav binary
*.mp3 binary
