# Dockerfile for MultipackParser C++ ARM64 Build using QEMU emulation
# This builds directly on ARM64 architecture using Docker's buildx/QEMU

ARG TARGETPLATFORM
FROM ubuntu:22.04

LABEL maintainer="Szaidel Cosmetic GmbH"
LABEL description="ARM64 build environment for MultipackParser C++"

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Berlin

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    ninja-build \
    pkg-config \
    # OpenGL (required by Qt6Gui)
    libgl1-mesa-dev \
    libegl1-mesa-dev \
    libgles2-mesa-dev \
    # Qt6
    qt6-base-dev \
    qt6-base-dev-tools \
    qt6-tools-dev \
    qt6-tools-dev-tools \
    qt6-multimedia-dev \
    libqt6sql6-sqlite \
    # SQLite
    libsqlite3-dev \
    # SSL
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Set Qt6 environment
ENV Qt6_DIR="/usr/lib/aarch64-linux-gnu/cmake/Qt6"

# Raspberry Pi 4 optimization flags
ENV CFLAGS="-mcpu=cortex-a72 -mtune=cortex-a72"
ENV CXXFLAGS="-mcpu=cortex-a72 -mtune=cortex-a72"

WORKDIR /src

# Build script - convert CRLF to LF for Windows compatibility
COPY docker-build.sh /usr/local/bin/
RUN sed -i 's/\r$//' /usr/local/bin/docker-build.sh && chmod +x /usr/local/bin/docker-build.sh

CMD ["/usr/local/bin/docker-build.sh"]
